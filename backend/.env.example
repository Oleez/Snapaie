# Copy these into Railway → Variables. Never commit real values.

# Required. The only place this key may ever exist is here — never in the APK.
GEMINI_API_KEY=

# Optional, and the two knobs that decide your bill.
#
# Condensing is where the money goes: a 500-page book is ~200k tokens in, ~60k out, so the
# input price dominates. 2.5-flash-lite costs 4.4c a book; 3.5-flash-lite costs 21c for the
# same work. The job is also forgiving — a poor reply is rejected and the phone finishes it.
GEMINI_MODEL_CONDENSE=gemini-2.5-flash-lite
#
# Transcription is where being wrong is expensive and volume is tiny. A misread page is
# invisible and everything after it condenses the mistake. One page is ~1k tokens, so a
# better model costs a quarter of a penny. Worth it on the one step that cannot self-correct.
GEMINI_MODEL_TRANSCRIBE=gemini-3.1-flash-lite

# Required in production. Signs the short-lived tokens the app carries.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Recommended. Add the Railway Postgres plugin and this is filled in for you.
# Without it, quota lives in memory and resets on every restart or redeploy,
# which means a determined user gets unlimited pages by waiting.
DATABASE_URL=

# Required before any purchase can be honoured. The JSON key for a Google Play
# service account with "View financial data" on your Play Console.
# Paste the whole JSON as one line.
PLAY_SERVICE_ACCOUNT_JSON=

# Your app's package name, checked against every purchase token.
PLAY_PACKAGE_NAME=com.snapaie.android

# Spend ceiling. The last line of defence if anything above is misconfigured.
MAX_PAGES_PER_DAY_GLOBAL=20000
